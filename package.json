{
  "name": "datads-project",
  "version": "1.0.0",
  "description": "DatAds take-home exercise, data polling, processing and query API",
  "scripts": {
    "extract": "ts-node part_2/src/index.ts",
    "serve": "ts-node part_3/src/server.ts",
    "serve:dev": "ts-node-dev --respawn part_3/src/server.ts",
    "test": "jest --forceExit",
    "build": "tsc",
    "lint": "eslint 'part_2/src/**/*.ts' 'part_3/src/**/*.ts'",
    "lint:fix": "eslint 'part_2/src/**/*.ts' 'part_3/src/**/*.ts' --fix",
    "format": "prettier --write 'part_2/src/**/*.ts' 'part_3/src/**/*.ts'"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
